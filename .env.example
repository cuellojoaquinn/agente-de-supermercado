# Copiá este archivo como .env y completá las claves. El .env no se sube al repo.

# Proveedor del modelo: gemini (por defecto), opencode o lmstudio
PROVEEDOR=gemini

# --- Gemini (Google AI Studio) ---------------------------------------------
# API key gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelo con tool calling. El tier gratuito tiene ~20 pedidos por día POR MODELO:
# si uno se agota o está saturado (503), cambiá a otro (ej: gemini-3.5-flash-lite).
MODELO=gemini-3.5-flash

# --- OpenCode Zen (API compatible con OpenAI) --------------------------------
# Los modelos gratis de OpenCode solo andan en su app: por API hace falta OpenCode Go.
# OPENCODE_API_KEY=
# MODELO_OPENCODE=deepseek-v4.1-flash-free
# OPENCODE_URL=https://opencode.ai/zen/v1

# --- LM Studio (modelo local, sin cuotas) ------------------------------------
# Cargá el modelo en LM Studio y encendé el servidor local.
# MODELO_LOCAL=qwen/qwen3.5-9b
# LMSTUDIO_URL=http://localhost:1234/v1
